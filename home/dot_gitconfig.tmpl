[user]
	name = José San Juan
	email = jose.sanjuan@tng.iac.es
[init]
	defaultBranch = main
[core]
	editor = vim
	autocrlf = input
	whitespace = trailing-space,space-before-tab
	excludesFile = ~/.config/git/ignore
[pull]
	rebase = false
[push]
	autoSetupRemote = true
	default = simple
[fetch]
	prune = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictStyle = zdiff3
{{- if eq .chezmoi.os "linux" }}
	# git mergetool abre los conflictos en kdiff3 (fusión a tres bandas).
	tool = kdiff3
[mergetool]
	# Sin copias *.orig de cada fichero en conflicto ni pregunta previa.
	keepBackup = false
	prompt = false
{{- end }}
[rerere]
	enabled = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	st = status --short --branch
	lg = log --graph --decorate --oneline --all
	last = log -1 --stat
	undo = reset --soft HEAD~1

# Host * va el último: ssh_config aplica la primera coincidencia de cada opción,
# así que los bloques específicos de arriba deben poder ganar.
Host *
{{- if eq .chezmoi.os "darwin" }}
  # UseKeychain sólo existe en el OpenSSH de Apple.
  IgnoreUnknown UseKeychain
  UseKeychain yes
  # macOS envía LANG y LC_* globalmente; no propagar la configuración regional.
  SendEnv -LANG -LC_*
  AddKeysToAgent yes
  TCPKeepAlive yes
  ServerAliveInterval 60
{{- else }}
  ServerAliveInterval 30
  XAuthLocation /usr/bin/xauth
{{- end }}
  ServerAliveCountMax 3
  HashKnownHosts yes

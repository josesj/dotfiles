# chezmoi no borra por su cuenta lo que deja de gestionar: los externos y
# archivos retirados se eliminan aquí.

# vim-polyglot: el runtime de Vim ya resalta Java, Python y C++.
.vim/pack/dotfiles/start/vim-polyglot

# Vim volvió a Catppuccin: restos de los temas de GitHub.
.vim/pack/dotfiles/start/vim-colors-github
.vim/colors/github_primer.vim
.vim/autoload/lightline/colorscheme/github_primer.vim

# Gradle vuelve a su home por defecto (~/.gradle), donde está gradle.properties;
# ~/.cache/gradle era un segundo home con cachés y daemons duplicados.
.cache/gradle
{{- if eq .chezmoi.os "darwin" }}
# macOS volvió de Kitty a Ghostty.
.config/kitty
{{- end }}
{{- if eq .chezmoi.os "linux" }}
# Ghostty sólo se usa en macOS: en Arch el terminal es Kitty.
.config/ghostty

# JBang usa JBANG_DIR también fuera de Zsh (environment.d); ~/.jbang es un resto.
.jbang

# Catppuccin salió del escritorio: restos del tema anterior.
.local/share/color-schemes/CatppuccinLatteBlue.colors
.local/share/color-schemes/CatppuccinMochaBlue.colors
.local/share/plasma/look-and-feel/local.catppuccin-latte-blue
.local/share/plasma/look-and-feel/local.catppuccin-mocha-blue

# EasyEffects se retiró: añadía latencia a todo el audio, también a la salida.
.config/autostart/easyeffects-service.desktop
.local/share/easyeffects/input/Micro.json
.local/share/easyeffects/autoload/input/alsa_input.usb-Sonix_Technology_Co.__Ltd._HD_Pro_Webcam_C920_SN0001-03.analog-stereo:analog-input-mic.json

# Deimos pasó a ser un equipo de desarrollo remoto: sin reproductores, OBS,
# LibreOffice, Spotify ni Bluetooth.
.config/mpv
.config/obs-studio
.config/spotify-launcher.conf
.config/bluedevilglobalrc
.config/wireplumber/wireplumber.conf.d/54-bluetooth-aac.conf
.local/bin/libreoffice-kf6-x11
.local/share/applications/libreoffice-*.desktop
{{- end }}

# chezmoi no borra por su cuenta lo que deja de gestionar: los externos y
# archivos retirados se eliminan aquí.

# vim-polyglot: el runtime de Vim ya resalta Java, Python y C++.
.vim/pack/dotfiles/start/vim-polyglot

# Gradle vuelve a su home por defecto (~/.gradle), donde está gradle.properties;
# ~/.cache/gradle era un segundo home con cachés y daemons duplicados.
.cache/gradle
{{- if eq .chezmoi.os "linux" }}
# JBang usa JBANG_DIR también fuera de Zsh (environment.d); ~/.jbang es un resto.
.jbang

# Catppuccin salió del escritorio: restos del tema anterior.
.local/share/color-schemes/CatppuccinLatteBlue.colors
.local/share/color-schemes/CatppuccinMochaBlue.colors
.local/share/plasma/look-and-feel/local.catppuccin-latte-blue
.local/share/plasma/look-and-feel/local.catppuccin-mocha-blue

{{- if eq .chezmoi.hostname "tycho" }}
# Tycho se usa en remoto para desarrollar y jugar con Sunshine: sin mpv,
# LibreOffice ni periféricos locales (el mando y el audio llegan por Moonlight).
# La configuración de OBS se deja porque guarda escenas y perfiles propios.
.config/mpv
.local/bin/libreoffice-kf6-x11
.local/share/applications/libreoffice-*.desktop
.config/wireplumber/wireplumber.conf.d/51-fiio-k3.conf
.config/wireplumber/wireplumber.conf.d/52-edifier-r1280db.conf
.config/systemd/user/steam-big-picture-on-xbox.service
{{- else }}
# Deimos es una estación de trabajo: fuera el bloqueo al iniciar la sesión, el
# ajuste del dongle y el arranque de Sunshine. Se conserva ~/.config/sunshine,
# que guarda los emparejamientos de Moonlight.
.config/autostart/lock-on-login.desktop
.local/bin/sunshine-display
.config/systemd/user/graphical-session.target.wants/app-dev.lizardbyte.app.Sunshine.service
{{- end }}
{{- end }}

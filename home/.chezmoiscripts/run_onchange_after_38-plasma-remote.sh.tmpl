{{- if eq .chezmoi.hostname "tycho" -}}
#!/usr/bin/env bash
# Tycho se usa en remoto con Sunshine y se despierta por WoL. Si
# PowerDevil apaga la salida de vídeo, Sunshine captura en negro; y si suspende
# por inactividad, corta las sesiones SSH y los trabajos largos, que no cuentan
# como actividad. Se suspende a mano.
set -euo pipefail
command -v kwriteconfig6 >/dev/null || exit 0

kwriteconfig6 --file powerdevilrc --group AC --group Display \
  --key DimDisplayWhenIdle false
kwriteconfig6 --file powerdevilrc --group AC --group Display \
  --key TurnOffDisplayWhenIdle false
kwriteconfig6 --file powerdevilrc --group AC --group SuspendAndShutdown \
  --key AutoSuspendAction 0

# mpv ya no se instala: fuera la regla de KWin que centraba sus ventanas.
for key in Description wmclass wmclassmatch wmclasscomplete types \
           ignoregeometry ignoregeometryrule placement placementrule; do
  kwriteconfig6 --file kwinrulesrc --group dotfiles-mpv-centered --key "$key" --delete
done
rules=$(kreadconfig6 --file kwinrulesrc --group General --key rules)
if [[ ,$rules, == *,dotfiles-mpv-centered,* ]]; then
  rules=$(tr ',' '\n' <<<"$rules" | grep -vx dotfiles-mpv-centered | paste -sd, -)
  kwriteconfig6 --file kwinrulesrc --group General --key rules "$rules"
  kwriteconfig6 --file kwinrulesrc --group General --key count \
    "$(awk -F, '{print NF}' <<<"$rules")"
fi

command -v qdbus6 >/dev/null && {
  qdbus6 org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement \
    org.kde.Solid.PowerManagement.refreshStatus >/dev/null 2>&1 || true
  qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
}
{{- end -}}

{{- if and (eq .chezmoi.os "linux") (ne .chezmoi.hostname "tycho") -}}
#!/usr/bin/env bash
# Linux (Tycho y Deimos): los lanzadores de LibreOffice usan el backend KF6 sobre XWayland
# para mantener proporciones coherentes con el escalado fraccional de Plasma.
# El uso remoto retiró LibreOffice; al volver al escritorio se regeneran.
# wrapper sha256: {{ include "dot_local/bin/executable_libreoffice-kf6-x11" | sha256sum }}
# Este texto cambia para que chezmoi lo vuelva a ejecutar en Deimos tras volver al escritorio.
set -euo pipefail

source_dir=/usr/share/applications
target_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
wrapper="$HOME/.local/bin/libreoffice-kf6-x11"

[[ -x "$wrapper" ]] || exit 0

mkdir -p "$target_dir"
shopt -s nullglob
desktop_files=("$source_dir"/libreoffice-*.desktop)
if (( ${#desktop_files[@]} == 0 )); then
  printf 'Aviso: no se encontraron lanzadores de LibreOffice en %s\n' "$source_dir" >&2
  exit 0
fi

for source in "${desktop_files[@]}"; do
  target="$target_dir/${source##*/}"
  temporary=$(mktemp)
  sed "s|^Exec=libreoffice|Exec=$wrapper|" "$source" > "$temporary"
  if grep -q '^Exec=libreoffice' "$temporary" || ! grep -Fq "Exec=$wrapper" "$temporary"; then
    rm -f -- "$temporary"
    printf 'Error: no se pudo ajustar el lanzador %s.\n' "$source" >&2
    exit 1
  fi
  if ! cmp -s -- "$temporary" "$target"; then
    install -m644 -- "$temporary" "$target"
    printf 'Lanzador ajustado: %s\n' "$target"
  fi
  rm -f -- "$temporary"
done

command -v kbuildsycoca6 >/dev/null && kbuildsycoca6 --noincremental >/dev/null
{{- end -}}
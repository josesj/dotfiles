#!/usr/bin/env bash
# Retira configuraciones que los instaladores anteriores dejaron en su sitio y
# que ahora estorban: redirecciones de ZDOTDIR, restos de GNOME/Ghostty en Arch,
# EasyEffects, y los archivos de Zsh sueltos que en macOS vivían en $HOME.
# Se ejecuta una sola vez por equipo; todo lo retirado se guarda en una copia.
set -euo pipefail

backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

retire() {
  local target=$1 relative
  [[ -e "$target" || -L "$target" ]] || return 0
  relative=${target#"$HOME"/}
  mkdir -p -- "$(dirname -- "$backup_dir/$relative")"
  mv -- "$target" "$backup_dir/$relative"
  printf 'Retirado: %s -> %s\n' "$target" "$backup_dir/$relative"
}

# El historial pasa a ~/.local/state/zsh/history en los cuatro equipos.
history_file="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
if [[ -f "$HOME/.zsh_history" && ! -e "$history_file" ]]; then
  mkdir -p -- "$(dirname -- "$history_file")"
  mv -- "$HOME/.zsh_history" "$history_file"
  printf 'Historial migrado a %s\n' "$history_file"
fi

# Aliases y funciones pasan a ~/.config/zsh/. Los .backup.* de setup.sh sobran.
retire "$HOME/.zsh_aliases"
retire "$HOME/.zsh_functions"
for stale in "$HOME"/.zshrc.backup.* "$HOME"/.zprofile.backup.* \
             "$HOME"/.zcompdump-* "$HOME"/.zcompdump; do
  retire "$stale"
done

{{ if eq .chezmoi.os "linux" -}}
# vim-plug y sus plugins: ahora son paquetes nativos en ~/.vim/pack.
retire "${XDG_DATA_HOME:-$HOME/.local/share}/vim/autoload/plug.vim"
retire "${XDG_DATA_HOME:-$HOME/.local/share}/vim/plugged"

# El tema del prompt vivía dentro de ~/.oh-my-zsh, que ahora es un externo de
# chezmoi; ZSH_CUSTOM pasa a ~/.config/zsh/omz-custom.
retire "$HOME/.oh-my-zsh/custom/themes/workstation.zsh-theme"
{{- else -}}
# En macOS los plugins de Vim se clonaban a mano en pack/plugins y pack/vendor.
retire "$HOME/.vim/pack/plugins"
retire "$HOME/.vim/pack/vendor"
retire "$HOME/.vim/viminfo"

# Los plugins de Zsh vivían dentro de ~/.oh-my-zsh/custom, que ahora es un
# externo de chezmoi reemplazable por completo.
retire "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions"
retire "$HOME/.oh-my-zsh/custom/plugins/history-substring-search"
retire "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"

# ~/.ssh/config pasa a ser un único archivo en lugar de Include config.d/*.
if [[ -f "$HOME/.ssh/config" ]] && grep -Fqx 'Include ~/.ssh/config.d/*.conf' "$HOME/.ssh/config"; then
  retire "$HOME/.ssh/config.d"
fi
{{- end }}

printf 'Limpieza de configuraciones anteriores terminada.\n'

{{- if eq .chezmoi.hostname "tycho" -}}
#!/usr/bin/env bash
# Importa a NetworkManager los perfiles de OpenVPN de TNG (FGG y TNG), que
# `chezmoi apply` descifra en ~/.local/share/dotfiles/vpn/tng. Quedan sin
# autoconexión: se activan con `nmcli --ask connection up FGG`.
#
# Se ejecuta en cada apply y sólo reimporta un perfil si hace falta:
#   - la conexión no existe en NetworkManager;
#   - falta alguno de los ficheros que la conexión referencia (el importador
#     extrae el CA, el certificado y las claves del .ovpn a
#     ~/.local/share/networkmanagement/certificates/nm-openvpn/; si esa carpeta
#     se borra, openvpn falla con «Cannot pre-load keyfile»);
#   - el .ovpn descifrado cambió desde la última importación.
# Además fija vpn.user-name (hosts.yaml: openvpn_user). Reimportar sustituye la conexión y las credenciales que NetworkManager
# hubiera guardado, así que si todo está bien no se toca nada.
set -euo pipefail
command -v nmcli >/dev/null || exit 0

vpn_dir=$HOME/.local/share/dotfiles/vpn/tng
vpn_user={{ (index .hosts .chezmoi.hostname).openvpn_user | quote }}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles
mkdir -p "$state_dir"

needs_import() {   # needs_import NOMBRE FICHERO -> 0 si hay que importar
  local name=$1 source=$2 hash_file=$state_dir/openvpn-$1.sha256 data path
  nmcli -g connection.id connection show "$name" >/dev/null 2>&1 || return 0
  [[ -r $hash_file && "$(cat "$hash_file")" == "$(sha256sum "$source" | cut -d' ' -f1)" ]] || return 0
  data=$(nmcli -s -g vpn.data connection show "$name" 2>/dev/null) || return 0
  # Rutas absolutas de la conexión (ca, cert, key, tls-crypt...).
  while IFS= read -r path; do
    [[ -r $path ]] || return 0
  done < <(grep -oE '= /[^,]+' <<<"$data" | sed 's/^= //')
  return 1
}

for name in FGG TNG; do
  source=$vpn_dir/$name.ovpn
  [[ -r $source ]] || { printf 'Aviso: falta %s.\n' "$source" >&2; continue; }
  if needs_import "$name" "$source"; then
    nmcli connection delete "$name" >/dev/null 2>&1 || true
    nmcli connection import type openvpn file "$source" >/dev/null
    nmcli connection modify "$name" connection.autoconnect no
    sha256sum "$source" | cut -d' ' -f1 > "$state_dir/openvpn-$name.sha256"
    printf 'Perfil OpenVPN importado: %s\n' "$name"
  fi
  # Sin usuario, openvpn envía uno vacío y el servidor responde AUTH_FAILED.
  if [[ "$(nmcli -g vpn.user-name connection show "$name" 2>/dev/null)" != "$vpn_user" ]]; then
    nmcli connection modify "$name" vpn.user-name "$vpn_user"
    printf 'Usuario de %s: %s\n' "$name" "$vpn_user"
  fi
done
{{- end -}}

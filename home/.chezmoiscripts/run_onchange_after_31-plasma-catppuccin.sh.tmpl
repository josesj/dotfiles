{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Selecciona Catppuccin Latte/Mocha en Plasma y Konsole. Los esquemas de color,
# los perfiles de Konsole y los paquetes look-and-feel los instala chezmoi en
# ~/.local/share; aquí sólo se registran en la configuración de KDE.
# Latte sha256: {{ include "dot_local/share/color-schemes/CatppuccinLatteBlue.colors" | sha256sum }}
# Mocha sha256: {{ include "dot_local/share/color-schemes/CatppuccinMochaBlue.colors" | sha256sum }}
set -euo pipefail
command -v kwriteconfig6 >/dev/null || exit 0

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
requested_flavour=${1:-auto}

apply_kde_colors() {
  local source=$1 section='' line key value
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == \[*\] ]]; then
      section=${line#\[}
      section=${section%\]}
      continue
    fi
    [[ -n $line && $line != \#* && $line == *=* ]] || continue
    key=${line%%=*}
    value=${line#*=}
    case $section in
      ColorEffects:*|Colors:*|WM)
        kwriteconfig6 --file kdeglobals --group "$section" --key "$key" -- "$value"
        ;;
      General)
        [[ $key == ColorScheme ]] &&
          kwriteconfig6 --file kdeglobals --group General --key ColorScheme "$value"
        ;;
      KDE)
        [[ $key == contrast ]] &&
          kwriteconfig6 --file kdeglobals --group KDE --key contrast "$value"
        ;;
    esac
  done < "$source"
  kwriteconfig6 --file kdeglobals --group General --key ColorSchemeHash --delete
}

kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle Breeze
kwriteconfig6 --file kdeglobals --group General --key DefaultLightLookAndFeel \
  local.catppuccin-latte-blue
kwriteconfig6 --file kdeglobals --group General --key DefaultDarkLookAndFeel \
  local.catppuccin-mocha-blue

# Conserva el modo claro/oscuro actual y sustituye únicamente su paleta.
current_scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)
if [[ $requested_flavour == auto ]]; then
  case $current_scheme in
    *Latte*|*Light*) requested_flavour=latte ;;
    *)               requested_flavour=mocha ;;
  esac
fi
case $requested_flavour in
  latte)
    target_scheme=CatppuccinLatteBlue
    konsole_profile=CatppuccinLatte.profile
    look_and_feel=local.catppuccin-latte-blue
    ;;
  mocha)
    target_scheme=CatppuccinMochaBlue
    konsole_profile=CatppuccinMocha.profile
    look_and_feel=local.catppuccin-mocha-blue
    ;;
  *)
    printf 'Uso: %s [auto|latte|mocha]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

if [[ $current_scheme != "$target_scheme" ]]; then
  apply_kde_colors "$data_home/color-schemes/$target_scheme.colors"
fi
kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$look_and_feel"
kwriteconfig6 --file konsolerc --group 'Desktop Entry' --key DefaultProfile "$konsole_profile"

if command -v qdbus6 >/dev/null; then
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
fi

printf 'Plasma y Konsole configurados con Catppuccin Latte/Mocha.\n'
{{- end -}}
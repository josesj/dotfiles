{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Energía de la estación de trabajo: GNOME atenúa y apaga la pantalla por
# inactividad con sus valores de serie (se borran las claves, para seguir los que
# traiga GNOME), pero en corriente no suspende solo: SSH y los trabajos largos
# (Docker, compilaciones) no cuentan como actividad y la suspensión los cortaría.
# gnome-shell: {{ lookPath "gnome-shell" }}
set -euo pipefail
command -v gnome-shell >/dev/null || exit 0
command -v gsettings >/dev/null || exit 0

# Sin gnome-settings-daemon el esquema de energía no existe: no hay nada que
# restablecer y no se anuncia nada.
reset_key() {
  gsettings writable "$1" "$2" >/dev/null 2>&1 || return 0
  gsettings reset "$1" "$2"
  changed=true
}

set_key() {
  gsettings writable "$1" "$2" >/dev/null 2>&1 || return 0
  gsettings set "$1" "$2" "$3"
  changed=true
}

changed=false

power=org.gnome.settings-daemon.plugins.power
reset_key "$power" idle-dim
reset_key "$power" sleep-inactive-ac-timeout
set_key "$power" sleep-inactive-ac-type nothing
reset_key org.gnome.desktop.session idle-delay

$changed && printf 'Energía de GNOME: pantalla de serie y sin suspensión en corriente.\n'
{{- end -}}

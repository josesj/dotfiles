{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Energía de la estación de trabajo: GNOME recupera sus valores de serie
# (atenuar y apagar la pantalla por inactividad y suspender), como hace
# 37-plasma-power con PowerDevil. Se borran las claves en lugar de fijar
# valores, para seguir los que traiga GNOME.
set -euo pipefail
command -v gnome-shell >/dev/null || exit 0
command -v gsettings >/dev/null || exit 0

# Sin gnome-settings-daemon el esquema de energía no existe: no hay nada que
# restablecer y no se anuncia nada.
reset_key() {
  gsettings writable "$1" "$2" >/dev/null 2>&1 || return 0
  gsettings reset "$1" "$2"
  changed=true
}

changed=false

power=org.gnome.settings-daemon.plugins.power
reset_key "$power" idle-dim
reset_key "$power" sleep-inactive-ac-type
reset_key "$power" sleep-inactive-ac-timeout
reset_key org.gnome.desktop.session idle-delay

$changed && printf 'Energía de GNOME: valores de serie.\n'
{{- end -}}

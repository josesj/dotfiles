{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Energía de PowerDevil. Atenuar y apagar la pantalla por inactividad usan los valores
# de serie de Plasma (se borran las claves, para seguir los que traiga).
#
# La suspensión por inactividad sólo se deja como viene de serie con `idle_suspend: true`
# en hosts.yaml (tycho, que se despierta por WoL). Sin la clave (deimos: Docker, copias
# de borgmatic y acceso remoto), en corriente no suspende solo: SSH y los trabajos largos
# no cuentan como actividad y la suspensión los cortaría.
set -euo pipefail
command -v kwriteconfig6 >/dev/null || exit 0

kwriteconfig6 --file powerdevilrc --group AC --group Display \
  --key DimDisplayWhenIdle --delete
kwriteconfig6 --file powerdevilrc --group AC --group Display \
  --key TurnOffDisplayWhenIdle --delete
{{- if get (index .hosts .chezmoi.hostname) "idle_suspend" }}
kwriteconfig6 --file powerdevilrc --group AC --group SuspendAndShutdown \
  --key AutoSuspendAction --delete
{{- else }}
# 0 = no hacer nada
kwriteconfig6 --file powerdevilrc --group AC --group SuspendAndShutdown \
  --key AutoSuspendAction 0
{{- end }}

command -v qdbus6 >/dev/null && {
  qdbus6 org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement \
    org.kde.Solid.PowerManagement.refreshStatus >/dev/null 2>&1 || true
}
{{- end -}}

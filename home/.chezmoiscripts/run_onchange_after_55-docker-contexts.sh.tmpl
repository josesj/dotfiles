{{- $contexts := get (index .hosts .chezmoi.hostname) "docker_contexts" -}}
{{- if and (eq .chezmoi.os "darwin") $contexts -}}
#!/usr/bin/env bash
# Contextos de Docker para usar el motor de los equipos Arch desde un Mac por
# SSH, según `docker_contexts` en hosts.yaml. No cambia el contexto activo:
# `docker --context deimos ...` o `docker context use deimos`. Se vuelve a
# ejecutar cuando cambia este script o esa lista.
set -euo pipefail

command -v docker >/dev/null || {
  printf 'Aviso: Docker no está instalado; se omiten los contextos.\n' >&2
  exit 0
}

# nombre=endpoint; el host SSH se resuelve con ~/.ssh/config.
contexts=(
{{- range $name, $host := $contexts }}
  {{ printf "%s=%s" $name $host | quote }}
{{- end }}
)

for entry in "${contexts[@]}"; do
  name=${entry%%=*}
  host=${entry#*=}
  current=$(docker context inspect "$name" --format '{{ "{{.Endpoints.docker.Host}}" }}' 2>/dev/null || true)
  if [[ -z "$current" ]]; then
    docker context create "$name" --description "Docker de $name por SSH" --docker "host=$host" >/dev/null
  elif [[ "$current" != "$host" ]]; then
    docker context update "$name" --docker "host=$host" >/dev/null
  fi
done

printf 'Contextos de Docker configurados: %s.\n' "${contexts[*]%%=*}"
{{- end -}}

{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Kitty es el terminal de Plasma: Ctrl+Alt+T y el terminal predeterminado de
# KDE, que usan Dolphin («Abrir terminal») y las aplicaciones con Terminal=true;
# sin TerminalApplication, KDE abre Konsole.
# Konsole anuncia el mismo atajo por defecto. Persistir su retirada deja que la
# entrada de escritorio de Kitty se quede con Ctrl+Alt+T sin ambigüedad.
set -euo pipefail

if command -v kwriteconfig6 >/dev/null && command -v kitty >/dev/null; then
  kwriteconfig6 --file kdeglobals --group General --key TerminalApplication kitty
  kwriteconfig6 --file kdeglobals --group General --key TerminalService kitty.desktop
fi

if command -v kwriteconfig6 >/dev/null; then
  kwriteconfig6 --file kglobalshortcutsrc --group services \
    --group org.kde.konsole.desktop --key _launch none
fi

if command -v kitty >/dev/null && command -v xdg-mime >/dev/null; then
  xdg-mime default kitty.desktop x-scheme-handler/terminal 2>/dev/null || true
fi

if command -v kbuildsycoca6 >/dev/null; then
  kbuildsycoca6 --noincremental >/dev/null
fi

# Actualiza la sesión Plasma en marcha cuando KGlobalAccel es alcanzable.
# 201326676 es la representación entera portable de Ctrl+Alt+T en Qt.
if command -v gdbus >/dev/null &&
   gdbus introspect --session --dest org.kde.kglobalaccel \
     --object-path /kglobalaccel >/dev/null 2>&1; then
  gdbus call --session --dest org.kde.kglobalaccel \
    --object-path /kglobalaccel \
    --method org.kde.KGlobalAccel.setShortcut \
    "['org.kde.konsole.desktop', '_launch', 'Konsole', 'Konsole']" \
    '@ai []' 4 >/dev/null
  gdbus call --session --dest org.kde.kglobalaccel \
    --object-path /kglobalaccel \
    --method org.kde.KGlobalAccel.setShortcut \
    "['kitty.desktop', '_launch', 'kitty', 'kitty']" \
    '[201326676]' 4 >/dev/null
fi
{{- end -}}
{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Konsole anuncia el mismo atajo por defecto. Persistir su retirada deja que la
# entrada de escritorio del terminal predeterminado (Ghostty; Kitty mientras no
# esté instalado) se quede con Ctrl+Alt+T sin ambigüedad.
set -euo pipefail

if command -v ghostty >/dev/null; then
  term_desktop=com.mitchellh.ghostty.desktop
  term_name=Ghostty
elif command -v kitty >/dev/null; then
  term_desktop=kitty.desktop
  term_name=kitty
else
  term_desktop=
fi

if command -v kwriteconfig6 >/dev/null; then
  kwriteconfig6 --file kglobalshortcutsrc --group services \
    --group org.kde.konsole.desktop --key _launch none
fi

if [[ -n $term_desktop ]] && command -v xdg-mime >/dev/null; then
  xdg-mime default "$term_desktop" x-scheme-handler/terminal 2>/dev/null || true
fi

if command -v kbuildsycoca6 >/dev/null; then
  kbuildsycoca6 --noincremental >/dev/null
fi

# Actualiza la sesión Plasma en marcha cuando KGlobalAccel es alcanzable.
# 201326676 es la representación entera portable de Ctrl+Alt+T en Qt.
if [[ -n $term_desktop ]] && command -v gdbus >/dev/null &&
   gdbus introspect --session --dest org.kde.kglobalaccel \
     --object-path /kglobalaccel >/dev/null 2>&1; then
  gdbus call --session --dest org.kde.kglobalaccel \
    --object-path /kglobalaccel \
    --method org.kde.KGlobalAccel.setShortcut \
    "['org.kde.konsole.desktop', '_launch', 'Konsole', 'Konsole']" \
    '@ai []' 4 >/dev/null
  gdbus call --session --dest org.kde.kglobalaccel \
    --object-path /kglobalaccel \
    --method org.kde.KGlobalAccel.setShortcut \
    "['$term_desktop', '_launch', '$term_name', '$term_name']" \
    '[201326676]' 4 >/dev/null
fi
{{- end -}}
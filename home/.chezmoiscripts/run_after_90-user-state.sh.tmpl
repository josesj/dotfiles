#!/usr/bin/env bash
# Estado de usuario que no son archivos versionables: directorios de caché,
# completion de JBang y recarga de los subsistemas afectados.
set -euo pipefail

mkdir -p \
  "${XDG_CACHE_HOME:-$HOME/.cache}/vim/undo" \
  "${XDG_CACHE_HOME:-$HOME/.cache}/vim/swap" \
  "${XDG_CACHE_HOME:-$HOME/.cache}/vim/backup" \
  "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions" \
  "${XDG_STATE_HOME:-$HOME/.local/state}/zsh" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/jbang" \
  "$HOME/.local/bin"

# Generar la completion arranca la JVM: hacerlo aquí evita ese coste en cada
# terminal nueva. Se regenera cuando falta o cuando el ejecutable de JBang es
# más reciente que ella, es decir, tras una actualización (-nt sigue enlaces).
completion="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions/_jbang"
if jbang_bin=$(command -v jbang) &&
   [[ ! -s "$completion" || "$jbang_bin" -nt "$completion" ]]; then
  jbang completion zsh > "$completion"
fi

# Índices de la ayuda de los plugins de Vim, que chezmoi acaba de clonar o
# actualizar. Hacerlo aquí ahorra el helptags de cada arranque de Vim.
if command -v vim >/dev/null; then
  vim -Nu NONE -i NONE -es -c 'packloadall | silent! helptags ALL' -c q || true
fi

{{ if eq .chezmoi.os "linux" -}}
# El paquete nvm de Arch deja sus scripts en /usr/share/nvm, pero el plugin de
# Oh My Zsh sale sin hacer nada si no encuentra $NVM_DIR/nvm.sh, y NVM_DIR debe
# ser escribible porque ahí instala nvm las versiones de Node. Se copian cuando
# difieren, de modo que una actualización de pacman se propaga sola.
nvm_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nvm"
if [[ -d /usr/share/nvm ]]; then
  mkdir -p "$nvm_dir"
  for nvm_file in nvm.sh nvm-exec bash_completion; do
    if [[ -r "/usr/share/nvm/$nvm_file" ]] &&
       ! cmp -s -- "/usr/share/nvm/$nvm_file" "$nvm_dir/$nvm_file"; then
      install -m644 -- "/usr/share/nvm/$nvm_file" "$nvm_dir/$nvm_file"
    fi
  done
  [[ -e "$nvm_dir/nvm-exec" ]] && chmod 755 "$nvm_dir/nvm-exec"
fi

command -v systemctl >/dev/null && systemctl --user daemon-reload || true
{{- end }}

{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Fuentes de GNOME: Noto Sans para la interfaz y los documentos,
# JetBrainsMono Nerd Font Mono Medium para la monoespaciada. Sólo actúa donde
# está instalado GNOME Shell.
# gnome-shell: {{ lookPath "gnome-shell" }}
set -euo pipefail
command -v gnome-shell >/dev/null || exit 0
command -v gsettings >/dev/null || exit 0

set_key() {
  gsettings writable "$1" "$2" >/dev/null 2>&1 && gsettings set "$@"
}

interface=org.gnome.desktop.interface
set_key "$interface" font-name 'Noto Sans 10'
set_key "$interface" document-font-name 'Noto Sans 10'
set_key "$interface" monospace-font-name 'JetBrainsMono Nerd Font Mono Medium 10'
set_key org.gnome.desktop.wm.preferences titlebar-font 'Noto Sans Bold 10'

# Escala de grises con hinting ligero, como en fontconfig y en ~/.Xresources.
set_key "$interface" font-antialiasing grayscale
set_key "$interface" font-hinting slight

printf 'Fuentes de GNOME: Noto Sans; monoespaciada: JetBrainsMono Nerd Font Mono Medium.\n'
{{- end -}}

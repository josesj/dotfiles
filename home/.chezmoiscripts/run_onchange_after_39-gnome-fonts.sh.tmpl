{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Fuentes de GNOME: sus valores por defecto (Adwaita Sans a 11 pt y el
# renderizado automático, que decide suavizado y hinting según la resolución
# de la pantalla), salvo la monoespaciada: JetBrainsMono Nerd Font Mono Medium
# a 11 pt. Se restablecen las claves que fijaban versiones anteriores (Noto
# Sans, escala de grises manual). Sólo actúa donde está instalado GNOME Shell.
# gnome-shell: {{ lookPath "gnome-shell" }}
set -euo pipefail
command -v gnome-shell >/dev/null || exit 0
command -v gsettings >/dev/null || exit 0

interface=org.gnome.desktop.interface
for key in font-name document-font-name \
           font-antialiasing font-hinting font-rgba-order font-rendering; do
  gsettings reset "$interface" "$key"
done
gsettings reset org.gnome.desktop.wm.preferences titlebar-font
gsettings set "$interface" monospace-font-name 'JetBrainsMono Nerd Font Mono Medium 11'

printf 'Fuentes de GNOME: %s, monoespaciada %s.\n' \
  "$(gsettings get "$interface" font-name)" \
  "$(gsettings get "$interface" monospace-font-name)"
{{- end -}}

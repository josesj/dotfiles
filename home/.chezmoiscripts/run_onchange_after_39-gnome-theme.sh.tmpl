{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# GNOME usa su tema propio, Adwaita, y Catppuccin se conserva donde se lee
# texto —Ghostty, Vim y VS Code— pero no en el escritorio. Las aplicaciones GTK3
# (Spotify, Meld, GParted…) toman adw-gtk3 para parecerse a las GTK4/libadwaita.
# GTK3 no sigue el color-scheme de GNOME por sí solo: ~/.config/gtk-3.0/settings.ini
# fija gtk-application-prefer-dark-theme=0 y la barra de título se quedaba clara con
# el escritorio en oscuro. Por eso se elige la variante adw-gtk3 o adw-gtk3-dark
# según el modo activo al ejecutarse; si cambias de modo en Ajustes, hay que
# repetirlo: gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3[-dark].
# Un equipo que venga de KDE conserva en dconf los iconos y el cursor breeze; con
# ese tema ya desinstalado apuntarían a nada, así que se restablecen a los de
# GNOME. Los botones de ventana de KDE (`icon:minimize,maximize,close`) pintan el
# icono de la aplicación junto al primer botón de cada cabecera: se conservan
# minimizar y maximizar, pero sin el icono.
# gnome-shell: {{ lookPath "gnome-shell" }}
set -euo pipefail
command -v gnome-shell >/dev/null || exit 0
command -v gsettings >/dev/null || exit 0

for key in icon-theme cursor-theme; do
  if gsettings writable org.gnome.desktop.interface "$key" >/dev/null 2>&1 &&
     [[ $(gsettings get org.gnome.desktop.interface "$key") == \'breeze* ]]; then
    gsettings reset org.gnome.desktop.interface "$key"
    printf 'GNOME: %s restablecido (era Breeze).\n' "$key"
  fi
done

wm=org.gnome.desktop.wm.preferences
if gsettings writable "$wm" button-layout >/dev/null 2>&1 &&
   [[ $(gsettings get "$wm" button-layout) == *icon:* ]]; then
  gsettings set "$wm" button-layout 'appmenu:minimize,maximize,close'
  printf 'GNOME: button-layout con minimizar y maximizar y sin el icono de la aplicación.\n'
fi

# Otros valores que KDE sincroniza con dconf y que GNOME no usa: el estilo de las
# barras de herramientas GTK3 (sólo texto), el parpadeo del cursor y el factor de
# escala entera, que fuerza 1 en lugar de dejarlo automático.
for key in toolbar-style cursor-blink-time scaling-factor; do
  gsettings writable org.gnome.desktop.interface "$key" >/dev/null 2>&1 &&
    gsettings reset org.gnome.desktop.interface "$key"
done

gtk_theme=adw-gtk3
[[ $(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null) == *prefer-dark* ]] &&
  gtk_theme=adw-gtk3-dark
if [[ -d /usr/share/themes/$gtk_theme ]] &&
   gsettings writable org.gnome.desktop.interface gtk-theme >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
  printf 'Tema GTK3 de GNOME: %s.\n' "$gtk_theme"
fi
{{- end -}}

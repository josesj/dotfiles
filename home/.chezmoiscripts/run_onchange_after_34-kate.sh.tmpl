{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Kate como IDE ligero para Java, C, C++, Python, JavaScript y TypeScript.
# La configuración LSP y los temas de resaltado los instala chezmoi; aquí sólo
# se activan los complementos y se enlaza el tema con el modo del escritorio.
# LSP sha256: {{ include "dot_config/kate/lspclient/settings.json" | sha256sum }}
set -euo pipefail
command -v kwriteconfig6 >/dev/null || exit 0

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
lsp_config="$config_home/kate/lspclient/settings.json"
mkdir -p "$data_home/kate"

kwriteconfig6 --file katerc --group lspclient --key ServerConfiguration "$lsp_config"
kwriteconfig6 --file katerc --group lspclient --key AutoHover true
kwriteconfig6 --file katerc --group lspclient --key AutoImport true
kwriteconfig6 --file katerc --group lspclient --key CompletionDocumentation true
kwriteconfig6 --file katerc --group lspclient --key Diagnostics true
# El formato automático al guardar queda desactivado para evitar cambios
# inesperados; puede ejecutarse desde el complemento de formato de Kate.
kwriteconfig6 --file katerc --group lspclient --key FormatOnSave false
kwriteconfig6 --file katerc --group lspclient --key InlayHints true
kwriteconfig6 --file katerc --group lspclient --key SemanticHighlighting true
kwriteconfig6 --file katerc --group lspclient --key ShowCompletions true
kwriteconfig6 --file katerc --group lspclient --key SignatureHelp true
kwriteconfig6 --file katerc --group 'KTextEditor Renderer' --key 'Auto Color Theme Selection' true

desktop_scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)
case $desktop_scheme in
  *Latte*|*Light*) kate_theme='Catppuccin Latte' ;;
  *)               kate_theme='Catppuccin Mocha' ;;
esac
kwriteconfig6 --file katerc --group 'KTextEditor Renderer' --key 'Color Theme' "$kate_theme"

session="$data_home/kate/anonymous.katesession"
[[ -f "$session" ]] || printf '[Kate Plugins]\n' >"$session"

for plugin in \
  eslintplugin externaltoolsplugin formatplugin katebuildplugin katefiletreeplugin \
  kategdbplugin katekonsoleplugin kateprojectplugin katesearchplugin \
  katesnippetsplugin lspclientplugin tabswitcherplugin textfilterplugin; do
  kwriteconfig6 --file "$session" --group 'Kate Plugins' --key "$plugin" true
done

printf 'Kate configurado con LSP, formato, compilación, depuración y terminal.\n'
{{- end -}}
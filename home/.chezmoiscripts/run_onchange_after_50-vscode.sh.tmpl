#!/usr/bin/env bash
# Catppuccin Latte/Mocha en Visual Studio Code, con detección automática del
# modo claro/oscuro del sistema, y JetBrainsMono Nerd Font Mono en el editor y
# el terminal integrado a 14 px (el peso Medium lo fija editor.fontWeight).
# Los diálogos y los menús son los nativos de cada sistema (en Arch, los del
# portal de GNOME). La barra de título, el menú y los diálogos se excluyen de
# Settings Sync: los valores de Arch no aplican en macOS.
set -euo pipefail

command -v code >/dev/null || {
  printf 'Aviso: VS Code no está instalado; se omite Catppuccin.\n' >&2
  exit 0
}

code --install-extension Catppuccin.catppuccin-vsc --force >/dev/null

{{ if eq .chezmoi.os "darwin" -}}
settings="$HOME/Library/Application Support/Code/User/settings.json"
{{- else -}}
settings="${XDG_CONFIG_HOME:-$HOME/.config}/Code/User/settings.json"
{{- end }}
[[ -f "$settings" ]] || {
  printf 'Aviso: no existe %s; selecciona Catppuccin desde VS Code.\n' "$settings" >&2
  exit 0
}

# El archivo de ajustes es JSONC. Se sustituyen sólo las claves ya gestionadas
# para que comentarios, comas finales y ajustes personales queden intactos.
temporary=$(mktemp)
trap 'rm -f -- "$temporary"' EXIT
sed \
  -e 's/"workbench.colorTheme": "[^"]*"/"workbench.colorTheme": "Catppuccin Mocha"/' \
  -e 's/"workbench.preferredLightColorTheme": "[^"]*"/"workbench.preferredLightColorTheme": "Catppuccin Latte"/' \
  -e 's/"workbench.preferredDarkColorTheme": "[^"]*"/"workbench.preferredDarkColorTheme": "Catppuccin Mocha"/' \
  -e 's/"catppuccin.accentColor": "[^"]*"/"catppuccin.accentColor": "blue"/' \
  -e "s/\"editor.fontFamily\": \"[^\"]*\"/\"editor.fontFamily\": \"'JetBrainsMono Nerd Font Mono', monospace\"/" \
  -e "s/\"terminal.integrated.fontFamily\": \"[^\"]*\"/\"terminal.integrated.fontFamily\": \"'JetBrainsMono Nerd Font Mono', monospace\"/" \
  -e 's/"editor.fontSize": [0-9.]*/"editor.fontSize": 14/' \
  -e 's/"terminal.integrated.fontSize": [0-9.]*/"terminal.integrated.fontSize": 14/' \
  "$settings" > "$temporary"
if ! grep -Fq '"catppuccin.accentColor"' "$temporary"; then
  sed -i.bak '/"workbench.colorTheme"/i\
  "catppuccin.accentColor": "blue",
' "$temporary"
  rm -f -- "$temporary.bak"
fi
# `settingsSync.ignoredSettings` también se sincroniza, así que basta con que
# un equipo lo suba para que todos conserven sus valores locales.
if ! grep -Fq '"settingsSync.ignoredSettings"' "$temporary"; then
  sed -i.bak '/"workbench.colorTheme"/i\
  "settingsSync.ignoredSettings": ["window.titleBarStyle", "window.menuStyle", "window.dialogStyle"],
' "$temporary"
  rm -f -- "$temporary.bak"
fi
sed -i.bak 's/"settingsSync.ignoredSettings": \["window.titleBarStyle", "window.menuStyle"\]/"settingsSync.ignoredSettings": ["window.titleBarStyle", "window.menuStyle", "window.dialogStyle"]/' "$temporary"
rm -f -- "$temporary.bak"
{{- if eq .chezmoi.os "darwin" }}
sed -i.bak -e '/"window.titleBarStyle"[[:space:]]*:/d' -e '/"window.menuStyle"[[:space:]]*:/d' \
  -e '/"window.dialogStyle"[[:space:]]*:/d' "$temporary"
rm -f -- "$temporary.bak"
{{- else }}
# Los diálogos y menús personalizados que fijaba la configuración de Plasma se
# retiran: en GNOME los nativos encajan.
sed -i.bak -e '/"window.menuStyle"[[:space:]]*:/d' -e '/"window.dialogStyle"[[:space:]]*:/d' "$temporary"
rm -f -- "$temporary.bak"
{{- end }}
cmp -s -- "$temporary" "$settings" || install -m600 -- "$temporary" "$settings"

printf 'VS Code configurado con Catppuccin Latte/Mocha, detección automática y JetBrains Mono.\n'

#!/usr/bin/env bash
# Catppuccin Latte/Mocha en Visual Studio Code, con detección automática del
# modo claro/oscuro del sistema.
set -euo pipefail

command -v code >/dev/null || {
  printf 'Aviso: VS Code no está instalado; se omite Catppuccin.\n' >&2
  exit 0
}

code --install-extension Catppuccin.catppuccin-vsc --force >/dev/null

{{ if eq .chezmoi.os "darwin" -}}
settings="$HOME/Library/Application Support/Code/User/settings.json"
{{- else -}}
settings="${XDG_CONFIG_HOME:-$HOME/.config}/Code/User/settings.json"
{{- end }}
[[ -f "$settings" ]] || {
  printf 'Aviso: no existe %s; selecciona Catppuccin desde VS Code.\n' "$settings" >&2
  exit 0
}

# El archivo de ajustes es JSONC. Se sustituyen sólo las claves ya gestionadas
# para que comentarios, comas finales y ajustes personales queden intactos.
temporary=$(mktemp)
trap 'rm -f -- "$temporary"' EXIT
sed \
  -e 's/"workbench.colorTheme": "[^"]*"/"workbench.colorTheme": "Catppuccin Mocha"/' \
  -e 's/"workbench.preferredLightColorTheme": "[^"]*"/"workbench.preferredLightColorTheme": "Catppuccin Latte"/' \
  -e 's/"workbench.preferredDarkColorTheme": "[^"]*"/"workbench.preferredDarkColorTheme": "Catppuccin Mocha"/' \
  -e 's/"catppuccin.accentColor": "[^"]*"/"catppuccin.accentColor": "blue"/' \
  "$settings" > "$temporary"
if ! grep -Fq '"catppuccin.accentColor"' "$temporary"; then
  sed -i.bak '/"workbench.colorTheme"/i\
  "catppuccin.accentColor": "blue",
' "$temporary"
  rm -f -- "$temporary.bak"
fi
cmp -s -- "$temporary" "$settings" || install -m600 -- "$temporary" "$settings"

printf 'VS Code configurado con Catppuccin Latte/Mocha y detección automática.\n'

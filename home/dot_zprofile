# Sólo macOS (phobos, janus). Zsh lo lee en cada shell de login, antes de .zshrc.

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init --path)"

if /usr/libexec/java_home -v 25 >/dev/null 2>&1; then
  export JAVA_HOME="$(/usr/libexec/java_home -v 25)"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# OrbStack añade esta línea por su cuenta al instalarse. Aquí va ya
# condicionada para que chezmoi pueda regenerar el archivo sin romper la
# integración ni imponerla donde no está.
[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"

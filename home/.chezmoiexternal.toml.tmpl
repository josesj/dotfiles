# Oh My Zsh, sus plugins y los plugins de Vim se gestionan como repositorios
# externos: chezmoi los clona en el primer `apply` y los actualiza cuando pasa
# refreshPeriod. Sustituyen a los `git clone` que hacían install.sh y setup.sh.
#
# ZSH_CUSTOM vive fuera de ~/.oh-my-zsh para que el árbol de Oh My Zsh pueda
# reemplazarse por completo sin arrastrar configuración propia.
#
# Los plugins de Vim son paquetes nativos (~/.vim/pack). Sustituyen a vim-plug
# en Arch y a los `git clone` manuales de macOS: un solo mecanismo en los cuatro
# equipos, sin gestor de plugins dentro de Vim.
#
# Añadir un repositorio es añadir una línea a la tabla: destino y URL.
{{- $repos := dict
  ".oh-my-zsh" "https://github.com/ohmyzsh/ohmyzsh.git"

  ".config/zsh/omz-custom/plugins/zsh-autosuggestions" "https://github.com/zsh-users/zsh-autosuggestions.git"
  ".config/zsh/omz-custom/plugins/zsh-syntax-highlighting" "https://github.com/zsh-users/zsh-syntax-highlighting.git"
  ".config/zsh/omz-custom/plugins/zsh-history-substring-search" "https://github.com/zsh-users/zsh-history-substring-search.git"

  ".vim/pack/dotfiles/start/vim-one" "https://github.com/rakr/vim-one.git"
  ".vim/pack/dotfiles/start/lightline" "https://github.com/itchyny/lightline.vim.git"
  ".vim/pack/dotfiles/start/vim-gitgutter" "https://github.com/airblade/vim-gitgutter.git"
  ".vim/pack/dotfiles/start/ale" "https://github.com/dense-analysis/ale.git"
  ".vim/pack/dotfiles/start/fzf.vim" "https://github.com/junegunn/fzf.vim.git"
  ".vim/pack/dotfiles/start/vim-commentary" "https://github.com/tpope/vim-commentary.git"
  ".vim/pack/dotfiles/start/vim-surround" "https://github.com/tpope/vim-surround.git"
  ".vim/pack/dotfiles/start/vim-repeat" "https://github.com/tpope/vim-repeat.git"
  ".vim/pack/dotfiles/start/tagbar" "https://github.com/preservim/tagbar.git"
}}
{{- range $target, $url := $repos }}

[{{ $target | quote }}]
    type = "git-repo"
    url = {{ $url | quote }}
    refreshPeriod = "168h"
    [{{ $target | quote }}.clone]
        args = ["--depth=1"]
    [{{ $target | quote }}.pull]
        args = ["--ff-only"]
{{- end }}

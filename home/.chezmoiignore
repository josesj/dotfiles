{{/*
  Reparto de destinos por sistema operativo y por equipo. Todo lo que no se
  ignora aquí se aplica en los cuatro equipos.
*/}}

{{- if ne .chezmoi.os "darwin" }}
# --- Exclusivo de macOS (phobos, janus) ---
.zprofile
.config/ghostty
.config/dotfiles/Brewfile
.gnupg/gpg-agent.conf
{{- end }}

{{- /* Perfiles de VPN: los de TNG y los .mobileconfig son de macOS; los de
       WireGuard de lodero también se aplican en deimos, que los importa a
       NetworkManager (run_onchange_after_65-wireguard.sh.tmpl). */}}
{{- if and (ne .chezmoi.os "darwin") (ne .chezmoi.hostname "deimos") }}
.local/share/dotfiles
{{- else if ne .chezmoi.os "darwin" }}
.local/share/dotfiles/profiles
.local/share/dotfiles/vpn/tng
.local/share/dotfiles/vpn/lodero/iphone-*
.local/share/dotfiles/vpn/lodero/ipad-*
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# --- Exclusivo de Arch Linux (tycho, deimos) ---
.Xresources
.config/autostart
.config/chrome-flags.conf
.config/code-flags.conf
.config/environment.d
.config/fontconfig
.config/kate
.config/kitty
.config/mpv
.config/obs-studio
.config/pipewire
.config/systemd
.config/wireplumber
.config/xdg-terminals.list
.local/bin/desktop-unlock
.local/bin/libreoffice-kf6-x11
.local/share/applications
.local/share/easyeffects
.local/share/kio
.local/share/konsole
.local/share/org.kde.syntax-highlighting
{{- end }}

{{- if get (index .hosts .chezmoi.hostname) "remote" }}
# --- Equipos remotos (remote en hosts.yaml): sin reproductor, OBS ni LibreOffice ---
.config/mpv
.config/obs-studio
.local/bin/libreoffice-kf6-x11
{{- else }}
# --- Sólo los equipos remotos: Sunshine y el bloqueo al iniciar la sesión ---
.config/autostart/lock-on-login.desktop
.config/sunshine
.config/systemd/user/graphical-session.target.wants
.local/bin/lock-after-sunshine
.local/bin/sunshine-display
{{- end }}

{{- if or (ne .chezmoi.hostname "tycho") (get (index .hosts .chezmoi.hostname) "remote") }}
# --- Exclusivo de Tycho como estación de trabajo: FiiO K3, Edifier, mando Xbox ---
.config/wireplumber/wireplumber.conf.d/51-fiio-k3.conf
.config/wireplumber/wireplumber.conf.d/52-edifier-r1280db.conf
.config/systemd/user/steam-big-picture-on-xbox.service
{{- end }}

{{- if ne .chezmoi.hostname "deimos" }}
# --- Exclusivo de Deimos: nodo HDMI AMD que se duplicaba al reconectar y ROCm para gfx1032 ---
.config/wireplumber/wireplumber.conf.d/10-alsa.conf
.config/environment.d/50-rocm.conf
{{- end }}

{{/*
  Reparto de destinos por sistema operativo y por equipo. Todo lo que no se
  ignora aquí se aplica en los tres equipos.
*/}}

{{- if ne .chezmoi.os "darwin" }}
# --- Exclusivo de macOS (phobos, tycho) ---
.zprofile
.config/ghostty
.config/dotfiles/Brewfile
{{- end }}

{{- /* Perfiles de VPN: los .mobileconfig, los WireGuard de iPhone e iPad y los
       OpenVPN de TNG son de los Mac. Los WireGuard de phobos también se aplican en
       Deimos, que los importa a NetworkManager
       (run_onchange_after_65-wireguard.sh.tmpl); phobos-home-nodns, la variante
       sin DNS para la app de WireGuard de macOS, no. */}}
{{- if ne .chezmoi.os "darwin" }}
.local/share/dotfiles/profiles
.local/share/dotfiles/vpn/lodero/iphone-*
.local/share/dotfiles/vpn/lodero/ipad-*
.local/share/dotfiles/vpn/lodero/phobos-home-nodns.conf
.local/share/dotfiles/vpn/tng
{{- end }}
{{- if eq .chezmoi.hostname "tycho" }}
# tycho no usa WireGuard: sólo los OpenVPN de TNG.
.local/share/dotfiles/vpn/lodero
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# --- Exclusivo de Arch Linux (deimos) ---
.Xresources
.config/kitty
.config/btop/themes
.config/chrome-flags.conf
.config/chromium-flags.conf
.config/code-flags.conf
.config/environment.d
.config/fontconfig
.config/kate
.config/pipewire
.config/systemd
.config/wireplumber
.config/xdg-terminals.list
.local/bin/desktop-unlock
.local/bin/desktop-login
.local/bin/desktop-wake
.local/share/applications
.local/share/kio
.local/share/konsole
.local/share/org.kde.syntax-highlighting
# --- Ajustes de Plasma y aplicaciones (create_): sólo en Arch ---
.config/QtProject.conf
.config/baloofileinformationrc
.config/baloofilerc
.config/dolphinrc
.config/filetypesrc
.config/gtk-3.0
.config/gtk-4.0
.config/kaccessrc
.config/kactivitymanagerdrc
.config/kded5rc
.config/kdedefaults
.config/kdeglobals
.config/kdiff3fileitemactionrc
.config/kglobalshortcutsrc
.config/kiorc
.config/konsolesshconfig
.config/kscreenlockerrc
.config/ksmserverrc
.config/ktimezonedrc
.config/kwalletrc
.config/kwinoutputconfig.json
.config/kwinrc
.config/kxkbrc
.config/mimeapps.list
.config/plasma-localerc
.config/plasma-org.kde.plasma.desktop-appletsrc
.config/plasmanotifyrc
.config/plasmarc
.config/plasmashellrc
.config/powerdevilrc
.config/powermanagementprofilesrc
.config/user-dirs.dirs
.config/user-dirs.locale
.config/xsettingsd
.local/share/user-places.xbel
{{- end }}


{{- if ne .chezmoi.hostname "deimos" }}
# --- Exclusivo de Deimos: nodo HDMI AMD que se duplicaba al reconectar, ROCm
#     para gfx1032 y el escritorio remoto de KDE (KRDP) ---
.config/wireplumber/wireplumber.conf.d/10-alsa.conf
.config/environment.d/50-rocm.conf
.config/systemd/user/plasma-workspace.target.wants
{{- end }}

{{- if ne .chezmoi.hostname "deimos" }}
# Sólo existen en deimos
.config/QtProject.conf
.config/kdiff3fileitemactionrc
.config/konsolesshconfig
{{- end }}


{{- if and (eq .chezmoi.os "linux") (not (stat (joinPath .chezmoi.sourceDir (printf ".chezmoitemplates/state/%s/.local/share/user-places.xbel" .chezmoi.hostname)))) }}
# Los lugares de Dolphin sólo se crean si el equipo tiene su copia en state/:
# sin ella, la plantilla create_ fallaría al incluirla.
.local/share/user-places.xbel
{{- end }}

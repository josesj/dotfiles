#!/usr/bin/env bash
# Abre en una ventana nueva de VS Code cada carpeta seleccionada en Nautilus o,
# si no hay selección, la carpeta que se está viendo. Nautilus lo muestra en
# Scripts.
set -euo pipefail

folders=()
while IFS= read -r path; do
  [[ -n $path ]] || continue
  [[ -d $path ]] && folders+=("$path")
done <<< "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}"

if (( ${#folders[@]} == 0 )); then
  uri=${NAUTILUS_SCRIPT_CURRENT_URI:-}
  [[ $uri == file://* ]] || exit 0
  folders=("$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(urllib.parse.urlparse(sys.argv[1]).path))' "$uri")")
fi

for folder in "${folders[@]}"; do
  code --new-window "$folder" >/dev/null 2>&1 &
done

[Desktop Entry]
Type=Service
MimeType=inode/directory;
Actions=openInVisualStudioCode;
X-KDE-Priority=TopLevel
X-KDE-StartupNotify=false
Name=Open in Visual Studio Code
Comment=Open the selected directory in Visual Studio Code

[Desktop Action openInVisualStudioCode]
Name=Open in Visual Studio Code
Icon=vscode
Exec=code --new-window %f

#!/usr/bin/env bash
# Bloquea la sesión cuando Sunshine ya está en marcha. Lo lanza el autostart
# lock-on-login.desktop: el servicio de Sunshine espera 5 s tras el escritorio,
# así que bloquear antes lo dejaría arrancando detrás de la pantalla de bloqueo.
# Si Sunshine no sube en 90 s se bloquea igualmente: la sesión se abre sin
# contraseña y no puede quedar desprotegida.
#
# El bloqueo se comprueba: el bloqueador de Plasma puede no estar listo aún al
# arrancar, así que se reintenta hasta que ScreenSaver.GetActive diga que sí,
# con loginctl lock-session como alternativa. Los mensajes van al registro del
# usuario (journalctl --user -b | grep lock-after-sunshine).
set -u

service=app-dev.lizardbyte.app.Sunshine.service
web_port=47990

log() { printf 'lock-after-sunshine: %s\n' "$*"; }

for _ in $(seq 90); do
  if systemctl --user --quiet is-active "$service" &&
     ss -Htln "sport = :$web_port" 2>/dev/null | grep -q .; then
    log "Sunshine escucha en :$web_port"
    break
  fi
  sleep 1
done

screensaver() {
  dbus-send --session --print-reply --reply-timeout=5000 \
    --dest=org.freedesktop.ScreenSaver /ScreenSaver "org.freedesktop.ScreenSaver.$1"
}

locked() { screensaver GetActive 2>/dev/null | grep -q 'boolean true'; }

for attempt in $(seq 30); do
  if locked; then
    log "sesión bloqueada (intento $attempt)"
    exit 0
  fi
  if ! screensaver Lock >/dev/null 2>&1; then
    # Sin respuesta del bloqueador por D-Bus: se pide a logind, que avisa a
    # la sesión gráfica.
    loginctl lock-session "${XDG_SESSION_ID:-}" 2>/dev/null ||
      loginctl lock-sessions 2>/dev/null
  fi
  sleep 2
done

log "no se pudo comprobar el bloqueo tras 60 s"
exit 1

#!/usr/bin/env bash
# Ajusta una salida de KWin a la resolución y frecuencia que pide el cliente de
# Moonlight, para que Sunshine capture sin reescalar. Se usa desde los
# prep-cmd de apps.json:
#
#   sunshine-display apply <salida>    antes de la sesión (guarda el estado)
#   sunshine-display restore <salida>  al terminar (lo recupera)
#
# Sunshine exporta SUNSHINE_CLIENT_WIDTH, _HEIGHT y _FPS. Si la salida no tiene
# esa resolución, se deja como está y Sunshine reescala. Nunca falla: un error
# aquí no debe impedir la sesión de streaming.
set -uo pipefail

action=${1:-}
output=${2:-}
state="${XDG_RUNTIME_DIR:-/tmp}/sunshine-display-$output"

if [[ -z $output || ($action != apply && $action != restore) ]]; then
  printf 'Uso: %s apply|restore <salida>\n' "${0##*/}" >&2
  exit 0
fi

# Imprime "<id de modo> <escala>" para aplicar, o nada si no hay coincidencia.
choose_mode() {
  kscreen-doctor -j 2>/dev/null | python3 -c '
import json, sys
output, width, height, fps = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), float(sys.argv[4])
for o in json.load(sys.stdin)["outputs"]:
    if o["name"] != output:
        continue
    modes = [m for m in o["modes"]
             if m["size"]["width"] == width and m["size"]["height"] == height]
    if not modes:
        break
    # La más cercana a la pedida sin quedarse corta (120 antes que 119,88 o
    # 144); si ninguna llega, la mayor.
    faster = [m for m in modes if m["refreshRate"] >= fps - 0.5]
    mode = min(faster, key=lambda m: abs(m["refreshRate"] - fps)) if faster else \
        max(modes, key=lambda m: m["refreshRate"])
    # Escala para que el escritorio se lea en el cliente: 4K al 150 %, 1440p
    # al 125 % y el resto al 100 %.
    scale = 1.5 if height >= 2160 else 1.25 if height >= 1440 else 1
    print(mode["id"], scale)
' "$output" "$SUNSHINE_CLIENT_WIDTH" "$SUNSHINE_CLIENT_HEIGHT" "${SUNSHINE_CLIENT_FPS:-60}"
}

current_state() {
  kscreen-doctor -j 2>/dev/null | python3 -c '
import json, sys
for o in json.load(sys.stdin)["outputs"]:
    if o["name"] == sys.argv[1]:
        print(o["currentModeId"], o["scale"])
' "$output"
}

case $action in
  apply)
    [[ -n ${SUNSHINE_CLIENT_WIDTH:-} && -n ${SUNSHINE_CLIENT_HEIGHT:-} ]] || exit 0
    read -r mode scale < <(choose_mode) || exit 0
    [[ -n ${mode:-} ]] || exit 0
    # Si quedó un estado sin restaurar (Sunshine se cerró a mitad de sesión),
    # se conserva: es el modo original, no el que puso la sesión anterior.
    [[ -s $state ]] || current_state > "$state"
    kscreen-doctor "output.$output.mode.$mode" "output.$output.scale.$scale" >/dev/null 2>&1
    ;;
  restore)
    [[ -r $state ]] || exit 0
    read -r mode scale < "$state"
    rm -f -- "$state"
    kscreen-doctor "output.$output.mode.$mode" "output.$output.scale.$scale" >/dev/null 2>&1
    ;;
esac
exit 0

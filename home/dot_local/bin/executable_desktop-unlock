#!/usr/bin/env bash
set -euo pipefail

current_uid=$(id -u)
found=false

while read -r session_id session_uid _rest; do
  [[ "$session_uid" == "$current_uid" ]] || continue
  session_type=$(loginctl show-session "$session_id" -p Type --value)
  session_class=$(loginctl show-session "$session_id" -p Class --value)
  session_state=$(loginctl show-session "$session_id" -p State --value)

  [[ "$session_type" == wayland || "$session_type" == x11 ]] || continue
  [[ "$session_class" == user && "$session_state" == active ]] || continue

  loginctl unlock-session "$session_id"
  printf 'Sesión gráfica %s (%s) desbloqueada.\n' "$session_id" "$session_type"
  found=true
done < <(loginctl list-sessions --no-legend)

if ! $found; then
  printf 'Error: no se encontró una sesión gráfica activa para el UID %s.\n' \
    "$current_uid" >&2
  exit 1
fi

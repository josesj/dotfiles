#!/usr/bin/env bash
set -euo pipefail

# LibreOffice 26.8's KF6 Wayland path scales its VCL toolbars and document
# canvas inconsistently at Plasma's fractional 150% scale. XWayland keeps the
# menu, controls and canvas at the proportions expected on this display.
export QT_QPA_PLATFORM=xcb
export SAL_USE_VCLPLUGIN=kf6

exec /usr/bin/libreoffice "$@"

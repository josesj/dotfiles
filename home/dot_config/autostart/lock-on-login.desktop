[Desktop Entry]
# Los equipos remotos inician la sesión de jose sin contraseña para que
# Sunshine corra como usuario desde el arranque (WoL). La pantalla se bloquea cuando
# Sunshine ya está en marcha (lock-after-sunshine): quien conecte por Moonlight
# desbloquea con la clave.
Type=Application
Name=Bloquear al iniciar la sesión
Exec=sh -c 'exec "$HOME/.local/bin/lock-after-sunshine"'
OnlyShowIn=KDE;
NoDisplay=true

{{- $host := index .hosts .chezmoi.hostname -}}
# {{ $host.mpv_comment }}
vo=gpu-next
gpu-api=vulkan
gpu-context=waylandvk
hwdec={{ $host.mpv_hwdec }}
hwdec-codecs=all

# El escalado de alta calidad es barato en esta GPU. display-resample mantiene
# fluido el material a 24/25/30/50/60 fps en el escritorio 4K VRR.
scale=ewa_lanczossharp
cscale=ewa_lanczossharp
dscale=mitchell
correct-downscaling=yes
linear-downscaling=yes
sigmoid-upscaling=yes
video-sync=display-resample
interpolation=yes
tscale=oversample

# Pasa las capacidades del display a libplacebo y usa su modelo dinámico de HDR.
target-colorspace-hint=yes
tone-mapping=auto
hdr-compute-peak=yes

include=~~/common.conf

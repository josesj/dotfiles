{
  "servers": {
    "c": {
      "command": ["clangd", "--background-index", "--clang-tidy", "--completion-style=detailed"],
      "rootIndicationFileNames": ["compile_commands.json", "CMakeLists.txt", ".clangd"],
      "highlightingModeRegex": "^(C|ANSI C89|Objective-C)$"
    },
    "cpp": {
      "use": "c",
      "highlightingModeRegex": "^(C\\+\\+|ISO C\\+\\+|Objective-C\\+\\+)$"
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "rootIndicationFileNames": ["pyproject.toml", "uv.lock", "requirements.txt", ".git"],
      "highlightingModeRegex": "^Python$"
    },
    "javascript": {
      "command": ["typescript-language-server", "--stdio"],
      "rootIndicationFileNames": ["package.json", "package-lock.json", "jsconfig.json", "tsconfig.json", ".git"],
      "highlightingModeRegex": "^(JavaScript|TypeScript|JSX|TSX).*$"
    },
    "java": {
      "command": ["jdtls"],
      "rootIndicationFileNames": ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", ".git"],
      "highlightingModeRegex": "^Java$"
    }
  }
}

{{- $mac := eq .chezmoi.os "darwin" -}}
# Tipografía
font-family = JetBrainsMono Nerd Font
font-style = Medium
{{- if $mac }}
font-size = 15
font-thicken = true
{{- else }}
# El mismo tamaño que la monoespaciada de GNOME.
font-size = 11
{{- end }}

# Catppuccin cambia automáticamente con la apariencia del sistema.
theme = light:catppuccin-latte,dark:catppuccin-mocha
window-theme = system
{{- if $mac }}
window-colorspace = srgb
{{- end }}

# Cursor
cursor-style-blink = true

# Window
resize-overlay = never
minimum-contrast = 1.1
# La ventana abre siempre a 100x29 y deja la colocación al gestor de ventanas.
{{- if $mac }}
window-save-state = never
{{- end }}
window-padding-x = 10
window-padding-y = 8
window-width = 100
window-height = 29
adjust-cell-height = 2
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Comportamiento
{{- if $mac }}
# Equivale a `copy_on_select clipboard` en Kitty.
copy-on-select = true
{{- else }}
# Copia al portapapeles y a la selección primaria: Ctrl+Shift+V pega del primero
# y el botón central de la segunda. Con `clipboard` sólo se llenaba el primero y
# el botón central no pegaba nada.
copy-on-select = both
{{- end }}
selection-clear-on-copy = false
scrollback-limit = 33554432
scrollbar = never

# Aviso de los comandos largos (más de 10 s) que terminan con la ventana sin
# foco: notificación del escritorio y marca de atención en la pestaña. Necesita
# la integración con la shell, que señala el final de cada comando.
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# Splits
unfocused-split-opacity = 0.85

# Mouse
mouse-hide-while-typing = true
mouse-shift-capture = never

# Terminal type nativo. La integración SSH instala su terminfo en el servidor
# y vuelve a xterm-256color automáticamente si el servidor no admite `tic`.
term = xterm-ghostty

# Shell integration
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
{{- if $mac }}

# macOS: Option como Alt (necesario para keybindings de zsh)
macos-option-as-alt = left

# Atajos. Los de zsh (Opt/Cmd+flechas, Cmd+Backspace), recargar la config y
# moverse entre splits ya vienen por defecto; Opt+Backspace también funciona sin
# atajo porque Option izquierda actúa como Alt y envía ESC DEL.
keybind = cmd+shift+r=reset
keybind = cmd+alt+equal=equalize_splits

# Terminal desplegable desde cualquier app (requiere permiso de Accesibilidad).
keybind = global:cmd+grave_accent=toggle_quick_terminal
{{- else }}

# Atajos. Los predeterminados de Ghostty en Linux cubren lo demás:
# Ctrl+Shift+T/W/N (pestaña/cerrar/ventana), Ctrl+Shift+O/E (divisiones),
# Ctrl+Alt+flechas (moverse entre divisiones) y Alt+1..9 (pestañas).
keybind = ctrl+shift+r=reset
keybind = ctrl+alt+equal=equalize_splits
{{- end }}

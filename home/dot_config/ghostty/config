# Ghostty, el terminal de macOS. Reproduce la configuración de Kitty de los
# equipos Arch (~/.config/kitty/kitty.conf): misma tipografía, tema, tamaño de
# ventana, portapapeles, avisos y atajos Ctrl+Shift, además de los Cmd propios
# de macOS.

# Tipografía: JetBrains Mono Medium con algo más de interlineado y trazo
# engrosado, como `modify_font cell_height 108%` y `text_composition_strategy`.
font-family = JetBrainsMono Nerd Font Mono
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 11
adjust-cell-height = 8%
font-thicken = true

# Catppuccin sigue la apariencia de macOS: Latte en claro y Mocha en oscuro.
theme = light:catppuccin-latte,dark:catppuccin-mocha
window-theme = system
window-colorspace = srgb

# Cursor de bloque fijo.
cursor-style = block
cursor-style-blink = false

# Ventana de 100x29 sin recordar tamaño ni posición, con margen de 4 px.
window-save-state = never
window-width = 100
window-height = 29
window-padding-x = 4
window-padding-y = 4
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
unfocused-split-opacity = 0.85
resize-overlay = never

# Historial amplio y portapapeles: la selección se copia al portapapeles; al
# pegar se protege contra órdenes peligrosas y se quitan espacios finales.
scrollback-limit = 104857600
copy-on-select = clipboard
selection-clear-on-copy = false
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true

# Integración con Zsh: títulos, directorio actual y saltos entre prompts. El
# cursor y sudo se dejan como están; por SSH instala su terminfo en el
# servidor, o recurre a xterm-256color si no puede.
shell-integration-features = no-cursor,no-sudo,title,ssh-env,ssh-terminfo
confirm-close-surface = true

# Aviso del sistema cuando un comando de más de 15 s termina sin foco.
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 15s

# Option izquierda como Alt, para los atajos de Zsh.
macos-option-as-alt = left

# Atajos de Kitty en Arch. Los Cmd de macOS (Cmd+T, Cmd+D, Cmd+F...) siguen
# funcionando.
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab

keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+equal=equalize_splits
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+shift+x=close_surface

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1
keybind = ctrl+shift+r=reset

keybind = f11=toggle_fullscreen
keybind = ctrl+comma=open_config
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+shift+f1=toggle_command_palette

# Tipografía
font-family = JetBrainsMono Nerd Font
font-style = Medium
font-size = 15
font-thicken = true

# Catppuccin cambia automáticamente con la apariencia de macOS.
theme = light:catppuccin-latte,dark:catppuccin-mocha
window-theme = system
window-colorspace = srgb

# Cursor
cursor-style-blink = true

# Window
resize-overlay = never
minimum-contrast = 1.1
# La ventana abre siempre a 100x29 y deja la colocación al gestor de ventanas,
# igual que `remember_window_size no` en la configuración de Kitty en Arch.
window-save-state = never
window-padding-x = 10
window-padding-y = 8
window-width = 100
window-height = 29
adjust-cell-height = 2
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Comportamiento
# Equivale a `copy_on_select clipboard` en Kitty.
copy-on-select = true
selection-clear-on-copy = false
scrollback-limit = 33554432
scrollbar = never

# Splits
unfocused-split-opacity = 0.85

# Mouse
mouse-hide-while-typing = true
mouse-shift-capture = never

# Terminal type nativo. La integración SSH instala su terminfo en el servidor
# y vuelve a xterm-256color automáticamente si el servidor no admite `tic`.
term = xterm-ghostty

# Shell integration
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# macOS: Option como Alt (necesario para keybindings de zsh)
macos-option-as-alt = left

# Atajos. Los de zsh (Opt/Cmd+flechas, Cmd+Backspace), recargar la config y
# moverse entre splits ya vienen por defecto; Opt+Backspace también funciona sin
# atajo porque Option izquierda actúa como Alt y envía ESC DEL.
keybind = cmd+shift+r=reset
keybind = cmd+alt+equal=equalize_splits

# Terminal desplegable desde cualquier app (requiere permiso de Accesibilidad).
keybind = global:cmd+grave_accent=toggle_quick_terminal

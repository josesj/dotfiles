# Tipografía
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true
font-feature = +calt
bold-is-bright = false

# Catppuccin cambia automáticamente con la apariencia de macOS.
theme = light:catppuccin-latte,dark:catppuccin-mocha
window-theme = system
window-colorspace = srgb

# Cursor
cursor-style-blink = true

# Window
resize-overlay = never
minimum-contrast = 1.1
# La ventana abre siempre a 100x29 y deja la colocación al gestor de ventanas,
# igual que `remember_window_size no` en la configuración de Kitty en Arch.
window-save-state = never
window-padding-x = 10
window-padding-y = 8
window-width = 100
window-height = 29
adjust-cell-height = 2
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Comportamiento
# Equivale a `copy_on_select clipboard` en Kitty.
copy-on-select = true
confirm-close-surface = true
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
selection-clear-on-copy = false
scrollback-limit = 33554432
scrollbar = never

# Splits
unfocused-split-opacity = 0.85

# Mouse
mouse-hide-while-typing = true
mouse-shift-capture = never

# Terminal type nativo. La integración SSH instala su terminfo en el servidor
# y vuelve a xterm-256color automáticamente si el servidor no admite `tic`.
term = xterm-ghostty

# Shell integration
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# macOS: Option como Alt (necesario para keybindings de zsh)
macos-option-as-alt = left
macos-auto-secure-input = true

# Keybindings comunes zsh en macOS
# Opt+Left/Right: saltar por palabras
keybind = alt+left=esc:b
keybind = alt+right=esc:f
# Opt+Backspace: borrar palabra anterior
keybind = alt+backspace=esc:0x7f
# Cmd+Left/Right: inicio/fin de línea
keybind = super+left=text:\x01
keybind = super+right=text:\x05
# Cmd+Backspace: borrar hasta inicio de línea
keybind = super+backspace=text:\x15

# Gestión de Ghostty
keybind = cmd+shift+comma=reload_config
keybind = cmd+shift+r=reset

# Navegación y ajuste de splits
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+alt+equal=equalize_splits

#!/usr/bin/env python3
# OBS reescribe basic.ini al salir, así que chezmoi solo fija las claves de
# vídeo y salida; el resto del perfil (servicio, rutas recientes...) es de OBS.
{{- $obs := (index .hosts .chezmoi.hostname).obs_encoder }}
import configparser
import os
import sys

MANAGED = {
    "Output": {
        "Mode": "Advanced",
        "DynamicBitrate": "true",
    },
    # Lienzo 4K nativo y salida 1440p60 con Lanczos.
    "Video": {
        "BaseCX": "3840",
        "BaseCY": "2160",
        "OutputCX": "2560",
        "OutputCY": "1440",
        "FPSType": "0",
        "FPSCommon": "60",
        "ScaleType": "lanczos",
    },
    "AdvOut": {
        # Emisión: H.264 reescalado a 1080p (RescaleFilter 4 = Lanczos).
{{- if eq $obs "nvenc" }}
        "Encoder": "obs_nvenc_h264_tex",
{{- else }}
        "Encoder": "ffmpeg_vaapi_tex",
{{- end }}
        "ApplyServiceSettings": "true",
        "UseRescale": "true",
        "RescaleRes": "1920x1080",
        "RescaleFilter": "4",
        "TrackIndex": "1",
        "AudioEncoder": "ffmpeg_aac",
        # Grabación: HEVC a 1440p con mezcla, micro y escritorio por separado.
{{- if eq $obs "nvenc" }}
        "RecEncoder": "obs_nvenc_hevc_tex",
{{- else }}
        "RecEncoder": "hevc_ffmpeg_vaapi_tex",
{{- end }}
        "RecType": "Standard",
        "RecFilePath": "{{ .chezmoi.homeDir }}/Videos/OBS",
        "RecFormat2": "hybrid_mp4",
        "RecUseRescale": "false",
        "RecAudioEncoder": "ffmpeg_aac",
        "RecTracks": "7",
        "Track1Bitrate": "160",
        "Track2Bitrate": "256",
        "Track3Bitrate": "256",
        "Track1Name": "Mezcla",
        "Track2Name": "Micro",
        "Track3Name": "Escritorio",
    },
}

# OBS no crea la carpeta de grabación y falla al empezar si no existe.
os.makedirs(MANAGED["AdvOut"]["RecFilePath"], exist_ok=True)

config = configparser.RawConfigParser()
config.optionxform = str
config.read_string(sys.stdin.read().lstrip("﻿"))
for section, values in MANAGED.items():
    if not config.has_section(section):
        config.add_section(section)
    for key, value in values.items():
        config.set(section, key, value)
config.write(sys.stdout, space_around_delimiters=False)

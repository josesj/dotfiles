#!/usr/bin/env python3
# Codificador de emisión: CBR 6000 kbps, keyframe cada 2 s y sin lookahead
# para no añadir latencia.
{{- $obs := (index .hosts .chezmoi.hostname).obs_encoder }}
import json
import sys

MANAGED = {
    "rate_control": "CBR",
    "bitrate": 6000,
    "keyint_sec": 2,
{{- if eq $obs "nvenc" }}
    "preset2": "p5",
    "tune": "hq",
    "multipass": "qres",
    "profile": "high",
    "bf": 2,
    "lookahead": False,
    "psycho_aq": True,
{{- else }}
    "bf": 0,
{{- end }}
}

text = sys.stdin.read().strip()
settings = json.loads(text) if text else {}
settings.update(MANAGED)
json.dump(settings, sys.stdout, indent=4)
sys.stdout.write("\n")

# Nunca versionar claves privadas en claro. Las públicas y los archivos
# encrypted_*.asc que genera `chezmoi add --encrypt` sí se versionan.
home/private_dot_ssh/id_*
!home/private_dot_ssh/*.pub
!home/private_dot_ssh/encrypted_*

# Estado local del sistema operativo.
.DS_Store

# El ignore global de Git excluye `*.local`, que también atrapa las carpetas
# .local de las copias de estado por equipo: se versionan.
!home/.chezmoitemplates/state/*/.local/

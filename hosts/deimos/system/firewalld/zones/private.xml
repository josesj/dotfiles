<?xml version="1.0" encoding="utf-8"?>
<!-- Deimos se usa desde varias redes, privadas y públicas, y el filtro por
     origen lo hace el cortafuegos corporativo. Por eso eno1 entera entra por
     esta zona: la asigna NetworkManager (connection.zone=private en la
     conexión "deimos static"), que manda sobre firewalld en las interfaces
     que gestiona. Las fuentes de abajo sólo cuentan si eno1 volviera a public. -->
<zone>
  <short>Private</short>
  <description>Trusted local networks and local-only services</description>
  <service name="ssh"/>
  <service name="dhcpv6-client"/>
  <service name="mdns"/>
  <service name="llmnr"/>
  <service name="rdp"/>
  <service name="ws-discovery-client"/>
  <source address="161.72.52.0/24"/>
  <source address="fe80::/10"/>
</zone>

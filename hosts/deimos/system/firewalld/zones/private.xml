<?xml version="1.0" encoding="utf-8"?>
<!-- La LAN de Deimos (161.72.52.0/24) y el enlace local IPv6 entran por aquí;
     el resto de orígenes caen en public, que sólo abre SSH. Sunshine y su
     interfaz web quedan limitados a la LAN. -->
<zone>
  <short>Private</short>
  <description>Trusted local networks and local-only services</description>
  <service name="ssh"/>
  <service name="dhcpv6-client"/>
  <service name="mdns"/>
  <service name="llmnr"/>
  <service name="sunshine"/>
  <service name="ws-discovery-client"/>
  <source address="161.72.52.0/24"/>
  <source address="fe80::/10"/>
</zone>

# System-wide SMTP relay for deimos.
defaults
auth on
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
timeout 30
syslog LOG_MAIL
aliases /etc/aliases

account tng
host smtp.tng.iac.es
port 587
domain deimos.tng.iac.es
from deimos@tng.iac.es
user jose.sanjuan@tng.iac.es
passwordeval "cat /etc/msmtp-password"
set_from_header on
allow_from_override off

account default : tng

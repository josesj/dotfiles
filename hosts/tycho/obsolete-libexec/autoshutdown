#!/usr/bin/env bash
# Apaga Tycho cuando lleva un rato sin uso. Lo ejecuta autoshutdown.timer cada
# minuto, como root. El equipo está en uso si se cumple cualquiera de estas
# condiciones:
#
#   - una conexión SSH establecida;
#   - una sesión de NVENC abierta: Sunshine sólo codifica mientras emite (y
#     OBS mientras graba);
#   - la GPU por encima de GPU_THRESHOLD %: un juego o un cálculo que sigue
#     corriendo sin nadie conectado;
#   - un inhibidor de systemd que bloquee el apagado o la suspensión, como el
#     de borgmatic durante una copia.
#
# Tras IDLE_MINUTES seguidos sin ninguna, apaga. El contador vive en /run, así
# que empieza de cero en cada arranque: tras encender por WoL hay IDLE_MINUTES
# para conectarse. Se despierta por WoL.
set -u

IDLE_MINUTES=30
GPU_THRESHOLD=15
config=/etc/autoshutdown.conf
# shellcheck source=/dev/null
[[ -r $config ]] && . "$config"

state_dir=/run/autoshutdown
idle_since="$state_dir/idle-since"
mkdir -p "$state_dir"

# Imprime el motivo por el que el equipo está en uso, o nada si no lo está.
busy_reason() {
  if ss -Htn state established '( sport = :22 )' | grep -q .; then
    echo "conexión SSH"
    return
  fi
  if command -v nvidia-smi >/dev/null; then
    local sessions utilization
    read -r sessions utilization < <(
      nvidia-smi --query-gpu=encoder.stats.sessionCount,utilization.gpu \
        --format=csv,noheader,nounits 2>/dev/null | tr -d ',' | head -1)
    if [[ ${sessions:-} =~ ^[0-9]+$ ]] && (( sessions > 0 )); then
      echo "codificación NVENC (Sunshine u OBS)"
      return
    fi
    if [[ ${utilization:-} =~ ^[0-9]+$ ]] && (( utilization > GPU_THRESHOLD )); then
      echo "GPU al ${utilization} %"
      return
    fi
  fi
  # Sólo los que bloquean el apagado o la suspensión; los de PowerDevil
  # bloquean las teclas, y los «delay» no impiden nada. Se leen de logind en
  # JSON: quién y por qué pueden llevar espacios.
  local who
  who=$(busctl --json=short call org.freedesktop.login1 /org/freedesktop/login1 \
      org.freedesktop.login1.Manager ListInhibitors 2>/dev/null | python3 -c '
import json, sys
for what, who, why, mode, uid, pid in json.load(sys.stdin)["data"][0]:
    if mode == "block" and {"shutdown", "sleep"} & set(what.split(":")):
        print(who)
        break
')
  if [[ -n $who ]]; then
    echo "inhibidor de $who"
    return
  fi
}

reason=$(busy_reason)
now=$(date +%s)

if [[ -n $reason ]]; then
  [[ -e $idle_since ]] && echo "En uso: $reason. Se reinicia la cuenta."
  rm -f -- "$idle_since"
  exit 0
fi

if [[ ! -s $idle_since ]]; then
  echo "$now" > "$idle_since"
  echo "Sin uso: se apagará en $IDLE_MINUTES min si sigue así."
  exit 0
fi

idle=$(( (now - $(<"$idle_since")) / 60 ))
if (( idle >= IDLE_MINUTES )); then
  echo "Sin uso durante $idle min: apagando."
  rm -f -- "$idle_since"
  systemctl poweroff
fi
